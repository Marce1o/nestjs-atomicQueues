{
  "name": "atomic-queues",
  "version": "3.0.0",
  "description": "Per-entity sequential processing for Node.js — Worker Threads, gRPC cluster, strictly-once delivery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "atomic-queues": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Marce1o/nestjs-atomicQueues.git"
  },
  "homepage": "https://github.com/Marce1o/nestjs-atomicQueues#readme",
  "bugs": {
    "url": "https://github.com/Marce1o/nestjs-atomicQueues/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "copy-package": "node -e \"const p=require('./package.json'); p.main='index.js'; p.types='index.d.ts'; p.files=['**/*.js','**/*.d.ts','**/*.js.map','**/*.d.ts.map']; require('fs').writeFileSync('./dist/package.json', JSON.stringify(p, null, 2));\"",
    "publish:local": "cd dist && npm publish --ignore-scripts",
    "print:local:instructions": "FOLDER=$(echo \"$PWD\"/atomicqueues-core*.tgz) && echo 'Reinstall with -> npm uninstall @atomicqueues/core && npm i file:'\"$FOLDER\"",
    "pack": "npm run build && npm run copy-package && cd dist && npm pack --ignore-scripts && npm run print:local:instructions",
    "test": "jest --testPathIgnorePatterns integration",
    "test:watch": "jest --watch --testPathIgnorePatterns integration",
    "test:integration": "jest --testPathPattern integration --runInBand",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "nestjs",
    "queue",
    "redis",
    "atomic",
    "virtual-actor",
    "actor-model",
    "distributed",
    "cqrs",
    "worker-threads",
    "grpc"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "ioredis": ">=5.0.0",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/cqrs": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "zod-to-json-schema": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "ioredis": "^5.10.1",
    "jest": "^29.5.0",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  }
}
